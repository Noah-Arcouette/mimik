include_rules

ifeq (@(USR_BIN_CC),y)
FLAGS=

ifeq (@(USR_BIN_CC_X86_16),y)
FLAGS+=-DSUPPORT_X86_16
endif

: foreach pre/*.c |> !cc $(FLAGS) |> $(OBJ)/usr.bin/cc/pre/%B.o {obj}
: foreach lex/*.c |> !cc $(FLAGS) |> $(OBJ)/usr.bin/cc/lex/%B.o {obj}
: foreach args/*.c |> !cc $(FLAGS) |> $(OBJ)/usr.bin/cc/args/%B.o {obj}
: foreach *.c |> !cc $(FLAGS) |> $(OBJ)/usr.bin/cc/%B.o {obj}
: {obj} |> !ccld $(FLAGS) |> $(DIST)/usr/bin/cc | $(ROOT)/<dist>

!realcc = | $(DIST)/usr/bin/cc \
	|> ^ CCLD     %b^ $(EXEC) $(DIST)/usr/bin/cc -E %f -I$(ROOT)/include/ |>

: foreach ./tests/*.c |> !realcc |>
endif
