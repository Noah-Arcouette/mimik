.gitignore

# Output files
ROOT=$(TUP_CWD)
OBJ=$(ROOT)/@(BUILD_OBJ)/
DIST=$(ROOT)/@(BUILD_DIST)/

# Host Toolchain
HOSTCFLAGS=@(BUILD_CFLAGS)
HOSTCFLAGS+=-I$(ROOT)/include/

HOSTLDFLAGS=
HOSTLDFLAGS=-L$(DIST)/lib/
HOSTLDFLAGS=-L$(DIST)/usr/lib/
HOSTLDFLAGS=-L$(OBJ)/lib/
HOSTLDFLAGS=-L$(OBJ)/usr.lib/

!hostccld = |> ^ HOSTCCLD %b^ \
	@(BUILD_CC) $(HOSTCFLAGS) $(HOSTLDFLAGS) -o %o %f |>
!hostcc   = |> ^ HOSTCC   %b^ @(BUILD_CC) $(HOSTCFLAGS) -c -o %o %f |>
!hostar   = |> ^ HOSTAR   %b^ @(BUILD_AR) rcs                 %o %f |>
!hostldso = |> ^ HOSTLDSO %b^ @(BUILD_LDSO) $(HOSTLDFLAGS) -o %o %f |>

!ln = |> ^ LN       %o^ ln -s $(LINK) %o |>

EXEC=@(BUILD_EXEC)

# Built Toolchain
!cp   = |> ^ CP       %b^ cat %f >%o |>
!comp = !cp
COMP_EXT=

ifeq (@(BUILD_TOOL_AS),y)
!as = | $(OBJ)/tool/<as> |> ^ AS       %b^ $(EXEC) $(OBJ)/tool/as -o %o %f |>
endif

ifeq (@(BUILD_TOOL_CC),y)
!cc = | $(OBJ)/tool/<cc> |> ^ CC       %b^ $(EXEC) $(OBJ)/tool/cc -o %o %f |>
endif

ifeq (@(BUILD_TOOL_LD),y)
!ld = | $(OBJ)/tool/<ld> $(OBJ)/tool/<strip> |> ^ LD       %b^ \
	STRIP=$(OBJ)/tool/strip $(EXEC) $(OBJ)/tool/ld -o %o %f |>
!ldscript = | $(OBJ)/tool/<ld> $(OBJ)/tool/<strip> |> ^ LD       %b^ \
	STRIP=$(OBJ)/tool/strip $(EXEC) $(OBJ)/tool/ld -T$(SCRIPT) -o %o %f |>
endif

ifeq (@(BUILD_TOOL_READMIO),y)
!readmio = | $(OBJ)/tool/<readmio> |> ^ READMIO  %b^ \
	$(EXEC) $(OBJ)/tool/readmio %f |>
endif

ifeq (@(BUILD_TOOL_MIO2BIN),y)
!mio2bin = | $(OBJ)/tool/<mio2bin> |> ^ MIO2BIN  %b^ \
	$(EXEC) $(OBJ)/tool/mio2bin -o %o %f |>
endif

ifeq (@(BUILD_TOOL_FDISK),y)
!fdisk = | $(OBJ)/tool/<fdisk> |> ^ FDISK    %o^ \
	$(EXEC) $(OBJ)/tool/fdisk %o |>
endif
